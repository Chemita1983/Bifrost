# Copy to bifrost.env and fill in real values. bifrost.env is git-ignored.
# Usage: docker compose --env-file bifrost.env up -d --build
DB_NAME=bifrost
DB_USER=bifrost
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_PORT=3306

# Port exposed on the host for the Bifrost API
APP_PORT=8080

# Steam synchronization
STEAM_API_KEY=
STEAM_ID=
# Optional: existing platform and digital store assigned to imported games
# STEAM_PLATFORM_ID=6
# STEAM_DIGITAL_PLATFORM_ID=1
